    "html": "<header class=\"border-b border-line bg-bg\">\n  <div class=\"mx-auto flex max-w-6xl items-center justify-between gap-s3 px-s4 py-s3\">\n    <a href=\"#\" class=\"font-heading text-lg font-semibold text-ink\">Northgate</a>\n    <nav class=\"flex gap-s4 text-sm text-muted\"><a href=\"#\" class=\"transition hover:text-ink\">Platform</a><a href=\"#\" class=\"transition hover:text-ink\">Security</a><a href=\"#\" class=\"transition hover:text-ink\">Docs</a></nav>\n  </div>\n</header>",
