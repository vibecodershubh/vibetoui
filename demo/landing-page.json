    "html": "<section class=\"bg-surface\">\n  <div class=\"mx-auto grid max-w-6xl items-end gap-s4 px-s4 py-s6 md:grid-cols-12\">\n    <h2 class=\"max-w-xl text-3xl font-semibold leading-tight tracking-tight text-ink md:col-span-8 md:text-4xl\">Your first bag ships this Tuesday.</h2>\n    <div class=\"md:col-span-4 md:text-right\">\n      <a href=\"#\" class=\"inline-block rounded-ui bg-accent px-s4 py-s2 font-medium text-on-accent transition hover:opacity-90\">Start a subscription</a>\n      <p class=\"mt-s2 text-sm text-muted\">Pause or cancel anytime.</p>\n    </div>\n  </div>\n</section>",
