# Copy to .env.local and fill in. Never commit real keys.
GEMINI_API_KEY=
# Model used for generation, patches and the interview, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Optional: a different (faster) model just for the short interview calls (default: GEMINI_MODEL)
GEMINI_INTERVIEW_MODEL=
# Optional: per-attempt model timeout in ms (default 25000)
LLM_TIMEOUT_MS=
# true = serve pre-saved output and a scripted interview, no API calls
DEMO_MODE=false
