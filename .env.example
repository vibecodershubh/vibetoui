# Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# Model used for generation (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: a faster model for the short interview calls (default: ANTHROPIC_MODEL)
ANTHROPIC_INTERVIEW_MODEL=
# Optional: per-attempt model timeout in ms (default 25000)
LLM_TIMEOUT_MS=
# true = serve pre-saved output and a scripted interview, no API calls
DEMO_MODE=false
